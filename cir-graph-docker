#!/usr/bin/env bash
# ==============================================================================
# cir-graph-docker — run cir-graph inside Docker on code in the current directory.
# Nothing to install besides Docker; the image carries a CIR-enabled clang.
#
#   cd ~/my-project
#   /path/to/cir-graph/cir-graph-docker src/*.c -I include      # -> ./artifacts/
#   /path/to/cir-graph/cir-graph-docker query summary           # query ./artifacts/graph.kuzu
#   /path/to/cir-graph/cir-graph-docker query cfg main
#   /path/to/cir-graph/cir-graph-docker shell                   # bash inside the image
#   /path/to/cir-graph/cir-graph-docker build [--prebuilt DIR]  # (re)build the image
#
# Tip: symlink it onto your PATH, e.g. ln -s "$PWD/cir-graph-docker" ~/.local/bin/
#
# The current directory is mounted at the same path inside the container, so
# inputs must live under it, and outputs (owned by you) land in it.
#
# Environment: CIR_GRAPH_IMAGE  image to use (default: cir-graph:latest)
# ==============================================================================
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(dirname "${SELF}")"
IMAGE="${CIR_GRAPH_IMAGE:-cir-graph:latest}"

die() { echo "[-] $*" >&2; exit 1; }

command -v docker >/dev/null 2>&1 || die "Docker is not installed (https://docs.docker.com/get-docker/)"
docker info >/dev/null 2>&1 || die "cannot reach the Docker daemon (is it running? are you in the 'docker' group?)"

build_image() {
    if [[ "${1:-}" == "--prebuilt" ]]; then
        [[ -n "${2:-}" && -x "${2}/bin/clang" ]] || die "usage: $(basename "$0") build --prebuilt /path/to/llvm-project/build"
        echo "[*] Building ${IMAGE} from the clang in ${2} ..."
        docker build -t "${IMAGE}" --build-arg CLANG_SOURCE=prebuilt \
            --build-context llvm-build="$(readlink -f "$2")" "${REPO_DIR}"
    else
        echo "[*] Building ${IMAGE} with clang compiled from source."
        echo "    This happens once and takes roughly 1-3 hours (needs ~8 GB RAM, ~30 GB disk)."
        docker build -t "${IMAGE}" "${REPO_DIR}"
    fi
}

if [[ "${1:-}" == "build" ]]; then
    shift
    build_image "$@"
    exit 0
fi

if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
    if [[ "${IMAGE}" == */* ]] && docker pull "${IMAGE}"; then
        :
    else
        cat >&2 <<EOF
[-] Docker image '${IMAGE}' not found. Create it once with one of:
      $(basename "$0") build                                  # compile clang from source (1-3 h)
      $(basename "$0") build --prebuilt ~/llvm-project/build  # reuse a CIR-enabled LLVM build (minutes)
    or point CIR_GRAPH_IMAGE at a published image (e.g. ghcr.io/<owner>/cir-graph:latest).
EOF
        exit 1
    fi
fi

WORK="$(pwd -P)"
[[ "${WORK}" != "/" ]] || die "run this from your project directory, not /"

# Inputs outside the mounted directory would be invisible inside the container.
for arg in "$@"; do
    if [[ "${arg}" == /* && -e "${arg}" ]]; then
        case "$(readlink -f "${arg}")/" in
            "${WORK}"/*) ;;
            *) die "'${arg}' is outside the current directory (${WORK}); cd to a directory that contains it" ;;
        esac
    fi
done

TTY=()
[[ -t 0 && -t 1 ]] && TTY=(-it)

case "${1:-}" in
    query) shift; CMD=(cir-graph-query "$@") ;;
    load)  shift; CMD=(cir-graph-load "$@") ;;
    cir)   shift; CMD=(cir-graph "$@") ;;          # cir-graph on existing .cir files
    shell) shift; CMD=(bash "$@") ;;
    ""|-h|--help) CMD=(analyze.sh --help) ;;
    *)     CMD=(analyze.sh "$@") ;;
esac

exec docker run --rm "${TTY[@]}" \
    --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "${WORK}:${WORK}" -w "${WORK}" \
    "${IMAGE}" "${CMD[@]}"

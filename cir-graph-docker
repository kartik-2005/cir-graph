#!/usr/bin/env bash
# ==============================================================================
# cir-graph-docker — run cir-graph inside Docker on code in the current directory.
# Nothing to install besides Docker; the image carries a CIR-enabled clang.
#
#   cd ~/my-project
#   /path/to/cir-graph/cir-graph-docker src/*.c -I include      # -> ./artifacts/
#   /path/to/cir-graph/cir-graph-docker query summary           # query ./artifacts/graph.kuzu
#   /path/to/cir-graph/cir-graph-docker query cfg main
#   /path/to/cir-graph/cir-graph-docker shell                   # bash inside the image
#   /path/to/cir-graph/cir-graph-docker build [--prebuilt DIR]  # (re)build the image
#
# Tip: symlink it onto your PATH, e.g. ln -s "$PWD/cir-graph-docker" ~/.local/bin/
#
# The current directory is mounted at the same path inside the container and
# outputs (owned by you) land in it. Inputs and -I directories elsewhere are
# mounted read-only automatically.
#
# Environment: CIR_GRAPH_IMAGE  image to use (default: cir-graph:latest)
# ==============================================================================
set -euo pipefail

# Portable path helpers (macOS ships bash 3.2 and a readlink without -f/-m).
resolve_symlinks() {        # follow symlinks of a file path
    local f="$1" t
    while [[ -L "${f}" ]]; do
        t="$(readlink "${f}")"
        case "${t}" in /*) f="${t}" ;; *) f="$(dirname "${f}")/${t}" ;; esac
    done
    printf '%s\n' "${f}"
}
abs_path() {                # absolute, symlink-free path; the path need not exist
    local p="$1" rest=""
    [[ "${p}" == /* ]] || p="$(pwd -P)/${p}"
    [[ -e "${p}" ]] && p="$(resolve_symlinks "${p}")"
    while [[ ! -d "${p}" ]]; do
        rest="/$(basename "${p}")${rest}"
        p="$(dirname "${p}")"
    done
    printf '%s%s\n' "$(cd "${p}" && pwd -P)" "${rest}"
}

SELF="$(resolve_symlinks "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "${SELF}")" && pwd -P)"
IMAGE="${CIR_GRAPH_IMAGE:-cir-graph:latest}"

die() { echo "[-] $*" >&2; exit 1; }

command -v docker >/dev/null 2>&1 || die "Docker is not installed (https://docs.docker.com/get-docker/)"
docker info >/dev/null 2>&1 || die "cannot reach the Docker daemon (is it running? are you in the 'docker' group?)"

build_image() {
    if [[ "${1:-}" == "--prebuilt" ]]; then
        [[ -n "${2:-}" && -x "${2}/bin/clang" ]] || die "usage: $(basename "$0") build --prebuilt /path/to/llvm-project/build"
        echo "[*] Building ${IMAGE} from the clang in ${2} ..."
        docker build -t "${IMAGE}" --build-arg CLANG_SOURCE=prebuilt \
            --build-context llvm-build="$(abs_path "$2")" "${REPO_DIR}"
    else
        echo "[*] Building ${IMAGE} with clang compiled from source."
        echo "    This happens once and takes roughly 1-3 hours (needs ~8 GB RAM, ~30 GB disk)."
        docker build -t "${IMAGE}" "${REPO_DIR}"
    fi
}

if [[ "${1:-}" == "build" ]]; then
    shift
    build_image "$@"
    exit 0
fi

if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
    if [[ "${IMAGE}" == */* ]] && docker pull "${IMAGE}"; then
        :
    else
        cat >&2 <<EOF
[-] Docker image '${IMAGE}' not found. Create it once with one of:
      $(basename "$0") build                                  # compile clang from source (1-3 h)
      $(basename "$0") build --prebuilt ~/llvm-project/build  # reuse a CIR-enabled LLVM build (minutes)
    or point CIR_GRAPH_IMAGE at a published image (any name containing a registry host).
EOF
        exit 1
    fi
fi

WORK="$(pwd -P)"
[[ "${WORK}" != "/" ]] || die "run this from your project directory, not /"

inside_work() { case "$1/" in "${WORK}"/*) return 0 ;; *) return 1 ;; esac; }

# The current directory is mounted read-write. Inputs outside it (a source file,
# an -I header directory such as ../shared/include) are mounted read-only at the
# same path, so the container sees exactly the paths given on the command line.
# Outputs must stay under the current directory.
EXTRA_MOUNTS=()
MOUNTED=$'\n'
add_ro_mount() {
    local dir="$1"
    case "${MOUNTED}" in *$'\n'"${dir}"$'\n'*) return 0 ;; esac
    MOUNTED+="${dir}"$'\n'
    EXTRA_MOUNTS+=(-v "${dir}:${dir}:ro")
}
# Rewrite each input path that lies outside the current directory to its real
# absolute path and mount its directory read-only; paths inside stay as given
# (so the graph records them relative to the project).
args=("$@")
NEWARGS=()
REAL=""
outside_input() {           # if $1 exists outside WORK: mount it, set REAL to its real path
    [[ -n "$1" && -e "$1" ]] || return 1
    REAL="$(abs_path "$1")"
    inside_work "${REAL}" && return 1
    if [[ -d "${REAL}" ]]; then add_ro_mount "${REAL}"; else add_ro_mount "$(dirname "${REAL}")"; fi
}
for (( i = 0; i < ${#args[@]}; i++ )); do
    arg="${args[i]}"
    case "${arg}" in
        --output-dir|--database|--output|-o|--json|--dot)
            next="${args[i+1]:-}"
            if [[ -n "${next}" ]] && ! inside_work "$(abs_path "${next}")"; then
                die "${arg} ${next} is outside the current directory (${WORK}); keep outputs and databases under it"
            fi
            NEWARGS+=("${arg}")
            [[ -n "${next}" ]] && NEWARGS+=("${next}")
            (( i += 1 )) ;;
        -I)
            next="${args[i+1]:-}"
            if outside_input "${next}"; then NEWARGS+=(-I "${REAL}"); else NEWARGS+=(-I "${next}"); fi
            (( i += 1 )) ;;
        -I*)
            if outside_input "${arg#-I}"; then NEWARGS+=("-I${REAL}"); else NEWARGS+=("${arg}"); fi ;;
        -*) NEWARGS+=("${arg}") ;;
        *)
            if outside_input "${arg}"; then NEWARGS+=("${REAL}"); else NEWARGS+=("${arg}"); fi ;;
    esac
done
set -- ${NEWARGS[@]+"${NEWARGS[@]}"}

TTY=()
[[ -t 0 && -t 1 ]] && TTY=(-it)

case "${1:-}" in
    query) shift; CMD=(cir-graph-query "$@") ;;
    load)  shift; CMD=(cir-graph-load "$@") ;;
    cir)   shift; CMD=(cir-graph "$@") ;;          # cir-graph on existing .cir files
    shell) shift; CMD=(bash "$@") ;;
    ""|-h|--help) CMD=(analyze.sh --help) ;;
    *)     CMD=(analyze.sh "$@") ;;
esac

exec docker run --rm ${TTY[@]+"${TTY[@]}"} \
    --user "$(id -u):$(id -g)" -e HOME=/tmp -e CIR_GRAPH_HOME="${HOME}" \
    -v "${WORK}:${WORK}" -w "${WORK}" ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"} \
    "${IMAGE}" "${CMD[@]}"
